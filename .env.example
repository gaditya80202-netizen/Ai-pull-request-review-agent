APP_ENV=development
LOG_LEVEL=INFO

# Local Redis
REDIS_URL=redis://localhost:6379/0

# Your existing Timescale/PostgreSQL database
TIGER_DATABASE_URL=

# DeepSeek API
DEEPSEEK_API_KEY=
