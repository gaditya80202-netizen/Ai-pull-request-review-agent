APP_ENV=development
LOG_LEVEL=INFO

# Local Redis
REDIS_URL=redis://localhost:6379/0

# Your existing Timescale/PostgreSQL database
TIGER_DATABASE_URL=

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

# Cloudflare Workers AI embeddings
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b

# Review safety
CONFIDENCE_THRESHOLD=0.7
DAILY_BUDGET_USD=5

GITHUB_WEBHOOK_SECRET=

GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY_PATH=github-app.pem
GITHUB_TEST_REPO=
GITHUB_API_VERSION=2022-11-28

DEEPSEEK_THINKING=disabled

LLM_MAX_OUTPUT_TOKENS=4096

AUTO_POST_ENABLED=false

EVALUATION_GATE_PASSED=false
EMBED_DIM=1024
EMBED_BATCH_SIZE=16

# Human-review API (required to enable HITL endpoints)
HITL_API_TOKEN=replace-with-a-random-secret
HITL_REVIEWER_ID=your-reviewer-id
