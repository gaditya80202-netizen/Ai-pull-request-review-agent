# Copy to .env and replace all placeholders. Never commit .env or private keys.
APP_ENV=development
LOG_LEVEL=INFO

# Redis
REDIS_URL=redis://localhost:6379/0

# PostgreSQL / TimescaleDB
TIGER_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# GitHub App
GITHUB_WEBHOOK_SECRET=replace-with-your-github-webhook-secret
GITHUB_APP_ID=YOUR_GITHUB_APP_ID
GITHUB_INSTALLATION_ID=YOUR_GITHUB_INSTALLATION_ID
GITHUB_PRIVATE_KEY_PATH=./github-app.pem
GITHUB_TEST_REPO=owner/repository
GITHUB_API_VERSION=2022-11-28

# DeepSeek
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=disabled
LLM_MAX_OUTPUT_TOKENS=4096
# Conservative token assumption used by the review budget estimator.
MAX_CONTEXT_TOKENS=131072
# MAX_REQUEST_BYTES is currently a code constant: 128 * 1024 in deepseek_client.py.

# Cloudflare Workers AI embeddings
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=replace-with-your-cloudflare-api-token
CLOUDFLARE_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
EMBED_DIM=1024
EMBED_BATCH_SIZE=16

# Review policy / spending safeguards
CONFIDENCE_THRESHOLD=0.7
DAILY_BUDGET_USD=5.0
AUTO_POST_ENABLED=false
EVALUATION_GATE_PASSED=false

# Dashboard authentication
HITL_API_TOKEN=replace-with-a-long-random-token
HITL_REVIEWER_ID=primary-reviewer
